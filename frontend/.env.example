# Python バックエンドのURL（/api/* をここへ転送）
BACKEND_URL=http://localhost:8000

# 認証モード: dev（開発用ユーザー切り替え） / entra（Entra IDでログイン）
NEXT_PUBLIC_AUTH_MODE=dev

# Entra ID（entra のとき）
# アプリ登録（SPA）のリダイレクトURIは https://<ドメイン>/redirect を登録する
NEXT_PUBLIC_ENTRA_TENANT_ID=
NEXT_PUBLIC_ENTRA_SPA_CLIENT_ID=
NEXT_PUBLIC_ENTRA_API_SCOPE=api://<API_CLIENT_ID>/access_as_user

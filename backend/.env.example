# データベース（未設定ならローカルの SQLite ファイル）
# 例: Azure Database for PostgreSQL → postgresql+psycopg://user:pass@host:5432/flow
DATABASE_URL=sqlite:///./flow.db

# 認証モード
#   dev   … 開発用。画面右上でユーザーを切り替えて権限を確認できる
#   entra … Entra ID のトークンを検証（本番）
AUTH_MODE=dev

# dev モードでDBが空のとき、デモ用の企業・業務・ユーザーを作る
SEED_DEMO=true

# Entra ID（AUTH_MODE=entra のとき）
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=

CORS_ORIGINS=http://localhost:3000

    branches {
        INTEGER id PK
        TEXT code UK
        TEXT name
    }
    bank_staff {
        INTEGER id PK
        INTEGER branch_id FK
        TEXT name
        TEXT email UK
        TEXT password_hash
    }
    company_codes {
        INTEGER id PK
        TEXT code UK
        INTEGER bank_staff_id FK
        INTEGER branch_id FK
        TEXT expires_at
        TEXT used_at
    }
    companies {
        INTEGER id PK
        INTEGER company_code_id FK
        INTEGER branch_id FK
        INTEGER bank_staff_id FK
        TEXT name
        TEXT industry
        INTEGER employee_count
    }
    company_users {
        INTEGER id PK
        INTEGER company_id FK
        TEXT name
        TEXT email UK
        TEXT password_hash
        TEXT role "owner/member"
    }
    talents {
        INTEGER id PK
        TEXT email UK
        TEXT password_hash
        TEXT name
        TEXT display_name
        TEXT main_job
        INTEGER available_hours_month
        INTEGER is_profile_public
    }
    skills {
        INTEGER id PK
        TEXT name UK
        TEXT category
    }
    talent_skills {
        INTEGER talent_id PK,FK
        INTEGER skill_id PK,FK
        INTEGER years
    }
    talent_bank_accounts {
        INTEGER id PK
        INTEGER talent_id FK
        TEXT bank_name
        TEXT branch_code
        TEXT account_number
        TEXT account_holder_kana
        TEXT verified_at
    }
    issue_options {
        INTEGER id PK
        TEXT category
        TEXT label
    }
    projects {
        INTEGER id PK
        INTEGER company_id FK
        INTEGER created_by FK
        TEXT status "draft/generated/published/closed/contracted"
        TEXT issue_free_text
        TEXT ai_summary
        TEXT ai_requirements
        TEXT public_title
        TEXT public_description
        INTEGER hours_per_month
        INTEGER duration_months
        INTEGER monthly_fee
        TEXT published_at
    }
    project_issues {
        INTEGER project_id PK,FK
        INTEGER issue_option_id PK,FK
    }
    project_skills {
        INTEGER project_id PK,FK
        INTEGER skill_id PK,FK
    }
    applications {
        INTEGER id PK
        INTEGER project_id FK
        INTEGER talent_id FK
        TEXT message
        TEXT status "applied/interview/selected/rejected"
    }
    interviews {
        INTEGER id PK
        INTEGER application_id FK
        TEXT scheduled_at
        INTEGER duration_min
        TEXT meeting_url
        TEXT status
    }
    contracts {
        INTEGER id PK
        INTEGER project_id FK
        INTEGER application_id FK
        INTEGER company_id FK
        INTEGER talent_id FK
        TEXT template_version
        TEXT start_date
        TEXT end_date
        INTEGER monthly_fee
        TEXT nda_agreed_at
        TEXT no_conflict_agreed_at
        TEXT company_signed_at
        TEXT talent_signed_at
        TEXT status
    }
    meetings {
        INTEGER id PK
        INTEGER contract_id FK
        TEXT held_at
        TEXT minutes
    }
    tasks {
        INTEGER id PK
        INTEGER contract_id FK
        TEXT title
        TEXT owner
        TEXT status
        TEXT due_date
    }
    work_logs {
        INTEGER id PK
        INTEGER contract_id FK
        TEXT work_date
        REAL hours
        TEXT kind "work/meeting/report"
    }
    reports {
        INTEGER id PK
        INTEGER contract_id FK
        TEXT period "YYYY-MM"
        TEXT summary
        TEXT body
        TEXT status
        TEXT submitted_at
        TEXT company_approved_at
    }
    sharing_consents {
        INTEGER id PK
        INTEGER contract_id FK
        TEXT party "company/talent"
        TEXT scope "none/summary/full"
        TEXT revoked_at
    }
    payments {
        INTEGER id PK
        INTEGER contract_id FK
        TEXT period
        INTEGER amount
        REAL billed_hours
        TEXT due_date
        TEXT company_paid_at
        TEXT talent_paid_at
        TEXT status
    }
    evaluations {
        INTEGER id PK
        INTEGER contract_id FK
        INTEGER rating "1-5"
        TEXT comment
    }
    achievements {
        INTEGER id PK
        INTEGER talent_id FK
        INTEGER contract_id FK
        TEXT title
        INTEGER show_industry
        INTEGER show_rating
        INTEGER is_public
    }
    notifications {
        INTEGER id PK
        TEXT recipient_type "company_user/talent/bank_staff"
        INTEGER recipient_id
        TEXT type
        TEXT title
        TEXT read_at
    }
    match_scores {
        INTEGER project_id PK,FK
        INTEGER talent_id PK,FK
        REAL score "0-1"
        TEXT keywords
        TEXT computed_at
    }
    bank_referrals {
        INTEGER id PK
        INTEGER company_id FK
        INTEGER bank_staff_id FK
        INTEGER project_id FK
        TEXT note
    }
